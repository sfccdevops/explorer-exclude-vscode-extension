{
  "name": "explorer-exclude-manager",
  "displayName": "Explorer Exclude Manager",
  "version": "1.4.1",
  "description": "Hide and manage Explorer and Search exclusions from the VS Code context menu.",
  "license": "MIT",
  "publisher": "MadCatPX",
  "categories": [
    "Other"
  ],
  "main": "extension/index.js",
  "icon": "extension/resources/icon.png",
  "galleryBanner": {
    "color": "#1c1c1c",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sfccdevops/explorer-exclude-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/sfccdevops/explorer-exclude-vscode-extension/issues"
  },
  "homepage": "https://github.com/sfccdevops/explorer-exclude-vscode-extension",
  "qna": false,
  "engines": {
    "vscode": "^1.110.0"
  },
  "keywords": [
    "context-menu",
    "exclude",
    "explorer",
    "files",
    "folders",
    "hidden",
    "hide",
    "ignore",
    "pane",
    "show",
    "toggle",
    "workspace"
  ],
  "activationEvents": [
    "onCommand:explorer-exclude-manager.disableAll",
    "onCommand:explorer-exclude-manager.addToExcludes",
    "onCommand:explorer-exclude-manager.enableAll",
    "onCommand:explorer-exclude-manager.enabled",
    "onCommand:explorer-exclude-manager.exclude",
    "onCommand:explorer-exclude-manager.hasLoaded",
    "onCommand:explorer-exclude-manager.missingWorkspace",
    "onCommand:explorer-exclude-manager.remove",
    "onCommand:explorer-exclude-manager.reset",
    "onCommand:explorer-exclude-manager.toggle",
    "onCommand:explorer-exclude-manager.toggleGroupExpansion",
    "onCommand:explorer-exclude-manager.toggleAllOff",
    "onCommand:explorer-exclude-manager.toggleAllOn",
    "onStartupFinished",
    "onView:extension"
  ],
  "contributes": {
    "configuration": [
      {
        "title": "%extension.title%",
        "properties": {
          "explorerExcludeManager.backup": {
            "order": 1,
            "type": [
              "object",
              "null"
            ],
            "default": {},
            "description": "%config.properties.backup%",
            "scope": "window"
          },
          "explorerExcludeManager.showPicker": {
            "order": 2,
            "type": "boolean",
            "default": true,
            "description": "%config.properties.showPicker%",
            "scope": "window"
          }
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "explorerExcludeManager.pane.items",
          "name": "%package.pane%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "explorerExcludeManager.pane.items",
        "contents": "%package.loading%",
        "when": "!explorer-exclude-manager.missingWorkspace && !explorer-exclude-manager.hasLoaded"
      },
      {
        "view": "explorerExcludeManager.pane.items",
        "contents": "%debug.logger.missingWorkspace%",
        "when": "explorer-exclude-manager.missingWorkspace"
      }
    ],
    "commands": [
      {
        "command": "explorer-exclude-manager.exclude",
        "title": "%package.exclude%"
      },
      {
        "command": "explorer-exclude-manager.addToExcludes",
        "title": "%package.addToExcludes%"
      },
      {
        "command": "explorer-exclude-manager.remove",
        "title": "%package.remove%"
      },
      {
        "command": "explorer-exclude-manager.toggle",
        "title": "%package.toggle%"
      },
      {
        "command": "explorer-exclude-manager.toggleGroupExpansion",
        "title": "%package.toggleGroupExpansion%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/expand-collapse.svg",
          "light": "extension/resources/light/expand-collapse.svg"
        }
      },
      {
        "command": "explorer-exclude-manager.toggleAllOn",
        "title": "%package.toggle%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/toggle-on.svg",
          "light": "extension/resources/light/toggle-on.svg"
        }
      },
      {
        "command": "explorer-exclude-manager.toggleAllOff",
        "title": "%package.toggle%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/toggle-off.svg",
          "light": "extension/resources/light/toggle-off.svg"
        }
      },
      {
        "command": "explorer-exclude-manager.disableAll",
        "title": "%package.disableAll%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/unchecked.svg",
          "light": "extension/resources/light/unchecked.svg"
        }
      },
      {
        "command": "explorer-exclude-manager.enableAll",
        "title": "%package.enableAll%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/checked.svg",
          "light": "extension/resources/light/checked.svg"
        }
      },
      {
        "command": "explorer-exclude-manager.reset",
        "title": "%package.reset%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/reset.svg",
          "light": "extension/resources/light/reset.svg"
        }
      },
      {
        "command": "explorer-exclude-manager.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Explorer Exclude Manager",
        "icon": {
          "dark": "extension/resources/dark/settings.svg",
          "light": "extension/resources/light/settings.svg"
        }
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "explorer-exclude-manager.addToExcludes",
          "group": "explorer-exclude-manager@1",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && activeViewlet == 'workbench.view.explorer'"
        }
      ],
      "view/item/context": [
        {
          "command": "explorer-exclude-manager.remove",
          "group": "explorer-exclude-manager@1",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && viewItem == removable"
        },
        {
          "command": "explorer-exclude-manager.disableAll",
          "group": "inline@1",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && (viewItem == group-files || viewItem == group-search)"
        },
        {
          "command": "explorer-exclude-manager.enableAll",
          "group": "inline@2",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && (viewItem == group-files || viewItem == group-search)"
        },
        {
          "command": "explorer-exclude-manager.toggleAllOff",
          "group": "inline@3",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && viewItem == group-files"
        },
        {
          "command": "explorer-exclude-manager.toggleGroupExpansion",
          "group": "inline@4",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && (viewItem == group-files || viewItem == group-search)"
        },
        {
          "command": "explorer-exclude-manager.reset",
          "group": "inline@5",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && (viewItem == group-files || viewItem == group-search)"
        },
        {
          "command": "explorer-exclude-manager.openSettings",
          "group": "inline@6",
          "when": "explorer-exclude-manager.hasLoaded && !explorer-exclude-manager.missingWorkspace && view == explorerExcludeManager.pane.items && (viewItem == group-files || viewItem == group-search)"
        }
      ]
    }
  },
  "scripts": {
    "test": "npm run -s test:lint && npm run -s test:unit",
    "test:unit": "node test/run.js",
    "test:lint": "eslint --ext .js ./extension",
    "package": "vsce package --githubBranch develop"
  },
  "dependencies": {
    "jsonc-parser": "^3.1.0",
    "marked": "^4.0.18",
    "vscode-nls-i18n": "^0.2.4"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.1",
    "babel-eslint": "^10.1.0",
    "eslint": "^8.20.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1"
  }
}
